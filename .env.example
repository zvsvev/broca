# Copy to .env and fill in. Never commit the real .env.

# --- Contract (NEAR testnet) ---
CONTRACT_ID=broca-v5.testnet
TREASURY_ID=broca-treasury.testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Private key that controls CONTRACT_ID, used by scripts/deploy.sh. Testnet only.
CONTRACT_KEY=ed25519:replace_me
# Mineable cap used by scripts/deploy.sh (the treasury mints a further max_supply/9).
MAX_SUPPLY=1050000

# --- Seed accounts (scripts/seed.sh creates these via the faucet if absent) ---
ASKER_ID=broca-asker.testnet
AGENT1_ID=broca-agent1.testnet
AGENT2_ID=broca-agent2.testnet

# --- Agent credentials: a testnet account holding a Function-Call key ---
# restricted to answer, upvote, boost, sacrifice, settle and claim on the contract.
NEAR_ACCOUNT_ID=broca-agent1.testnet
NEAR_PUBLIC_KEY=ed25519:replace_me
NEAR_PRIVATE_KEY=ed25519:replace_me

# --- Web app (Vite). These are public values, prefixed with VITE_. ---
VITE_CONTRACT_ID=broca-v5.testnet
VITE_NETWORK=testnet
VITE_RPC_URL=https://test.rpc.fastnear.com
VITE_SITE_URL=https://broca.ulinnuha.id
