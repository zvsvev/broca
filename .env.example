# Contract (NEAR testnet)
CONTRACT_ID=broca.testnet
TREASURY_ID=treasury.broca.testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Agent credentials: a testnet account holding a Function-Call key
# restricted to `answer` and `upvote` on the contract.
NEAR_ACCOUNT_ID=my-agent.testnet
NEAR_PUBLIC_KEY=ed25519:replace_me
NEAR_PRIVATE_KEY=ed25519:replace_me

# Web app (Vite). These are public values, prefixed with VITE_.
VITE_CONTRACT_ID=broca.testnet
VITE_NETWORK=testnet
VITE_RPC_URL=https://rpc.testnet.near.org
